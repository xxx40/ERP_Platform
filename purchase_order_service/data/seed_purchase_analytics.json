  "metric_registry": {
    "version": "procurement-metrics-v1.0.0",
    "effective_from": "2026-07-27",
    "metrics": [
      {
        "key": "purchase_amount",
        "label": "采购金额",
        "unit": "元",
        "definition": "统计周期内已纳入采购分析口径的订单含税金额合计",
        "formula": "SUM(tax_inclusive_order_amount)",
        "allowed_dimensions": ["category", "supplier"]
      },
      {
        "key": "order_count",
        "label": "订单量",
        "unit": "单",
        "definition": "统计周期内符合口径的去重采购订单数量",
        "formula": "COUNT(DISTINCT order_number)",
        "allowed_dimensions": ["category", "supplier"]
      },
      {
        "key": "average_order_amount",
        "label": "平均订单金额",
        "unit": "元",
        "definition": "统计周期采购金额除以采购订单量",
        "formula": "purchase_amount / order_count",
        "allowed_dimensions": []
      },
      {
        "key": "on_time_rate",
        "label": "按期交付率",
        "unit": "%",
        "definition": "统计周期内已完成交付订单中，实际交付日期不晚于承诺日期的订单占比",
        "formula": "on_time_completed_order_count / completed_due_order_count * 100",
        "allowed_dimensions": ["category", "supplier"]
      }
    ]
  },
