# Application
APP_ENV=development
IDENTITY_PROVIDER=development
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHMS=RS256
JWT_USER_CLAIM=sub
JWT_TENANT_CLAIM=tenant_id
JWT_ORG_CLAIM=org_code
JWT_ROLES_CLAIM=roles
JWT_DISPLAY_NAME_CLAIM=name
JWT_EMAIL_CLAIM=email
POLICY_PROVIDER=config
POLICY_PDP_URL=
POLICY_PDP_API_KEY=
KNOWLEDGE_ACCESS_PROVIDER=config
KNOWLEDGE_ACCESS_API_URL=
KNOWLEDGE_ACCESS_API_KEY=
PROVIDER_TIMEOUT_SECONDS=5
SECRET_PROVIDER=local
# Required before secrets can be saved through the admin API.
LOCAL_SECRET_MASTER_KEY=
LOCAL_SECRET_STORE_PATH=backend/data/secrets.enc.json
VAULT_BASE_URL=
VAULT_TOKEN=
# Production service identity: oauth2 or mtls. Development may keep api_key.
SERVICE_AUTH_MODE=api_key
SERVICE_OAUTH_TOKEN_URL=
SERVICE_OAUTH_CLIENT_ID=
SERVICE_OAUTH_CLIENT_SECRET=
SERVICE_OAUTH_SCOPE=
SERVICE_MTLS_CERT_PATH=
SERVICE_MTLS_KEY_PATH=
SERVICE_MTLS_CA_PATH=
# Keep empty to use DATABASE_PATH with local SQLite.
# PostgreSQL example: postgresql+asyncpg://erp_assistant:password@127.0.0.1:5432/erp_assistant
DATABASE_URL=
DATABASE_PATH=backend/data/app.db
DATABASE_AUTO_CREATE=true
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Development automatically allows localhost/127.0.0.1 on any port.
# Production should set explicit CORS_ORIGINS and leave this empty.
CORS_ORIGIN_REGEX=

# WISE knowledge search
WISE_BASE_URL=https://wise.cvte.com/api/v1
WISE_API_KEY=
WISE_KNOWLEDGE_BASE_IDS=
WISE_SEARCH_LIMIT=8
WISE_CONTEXT_LIMIT=5
WISE_QUERY_CONCURRENCY=4
AGENTIC_MAX_RETRIEVAL_ROUNDS=2
AGENTIC_MAX_SUBQUERIES=2
AGENTIC_COMPLETENESS_FOLLOWUPS=0
AGENTIC_RRF_K=60

# IMA knowledge search. Optional runtime source for Kingdee AI Cangqiong knowledge.
IMA_BASE_URL=https://ima.qq.com
IMA_CLIENT_ID=
IMA_API_KEY=
IMA_KNOWLEDGE_BASE_IDS=
IMA_SEARCH_LIMIT=10
IMA_MAX_PAGES=2
IMA_EVIDENCE_TARGET=3
IMA_TIMEOUT_SECONDS=30

# Confluence KB source verification. Keep the real token only in local .env.
CONFLUENCE_BASE_URL=https://kb.cvte.com
CONFLUENCE_ROOT_PAGE_ID=
CONFLUENCE_ACCESS_TOKEN=
CONFLUENCE_TIMEOUT_SECONDS=30

# Company model gateway (Anthropic Messages compatible)
ANTHROPIC_BASE_URL=https://token.cvte.com
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_AUTH_MODE=bearer
ANTHROPIC_MODEL=CVTE-AUTO
ANTHROPIC_FALLBACK_MODEL=
# auto disables long reasoning for DeepSeek-compatible models; use enabled/disabled to override.
ANTHROPIC_THINKING_MODE=auto
MODEL_TIMEOUT_SECONDS=60
LANGCHAIN_AGENT_ENABLED=true
LANGCHAIN_AGENT_MAX_TOKENS=700
LANGCHAIN_AGENT_TIMEOUT_SECONDS=20
# Outer request SLA leaves enough time for one bounded RAG answer repair.
REQUEST_TIMEOUT_SECONDS=135
EVIDENCE_ASSESSMENT_TIMEOUT_SECONDS=12
MEMORY_TURN_LIMIT=6

# Optional Langfuse Cloud or self-hosted metrics export. Business text is never exported.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
LANGFUSE_TIMEOUT_SECONDS=2

# Purchase order MVP adapter
PURCHASE_ORDER_PROVIDER=http
MOCK_ANALYTICS_PATH=purchase_order_service/data/seed_purchase_analytics.json
MOCK_ORDERS_PATH=backend/data/mock_purchase_orders.json
PURCHASE_ORDER_API_BASE_URL=http://127.0.0.1:8101
PURCHASE_ORDER_API_KEY=
PURCHASE_ORDER_API_TIMEOUT_SECONDS=5
PURCHASE_ORDER_USER_ID=demo-user
PURCHASE_ORDER_TENANT_ID=tenant-demo
PURCHASE_ORDER_ORG_CODE=ORG-DEMO-001

# Generic Business Integration Gateway and published Dataset catalog.
BUSINESS_DATA_API_BASE_URL=http://127.0.0.1:8101
BUSINESS_DATA_API_KEY=
BUSINESS_DATA_API_TIMEOUT_SECONDS=10
BUSINESS_DATASET_CATALOG_PATH=purchase_order_service/datasets.yaml
HTTP_TOOL_CATALOG_PATH=backend/config/http_tools.yaml
# Comma-separated private CIDRs explicitly approved for isolated connector workers.
# Loopback, link-local and cloud metadata addresses are always rejected.
DATA_CONNECTOR_ALLOWED_CIDRS=
DATA_CONNECTOR_TEST_TIMEOUT_SECONDS=8

# Isolated business-data worker. Production requires oauth2 or mtls plus Vault.
ORDER_SERVICE_APP_ENV=development
ORDER_SERVICE_AUTH_MODE=demo
ORDER_SERVICE_DATABASE_PATH=purchase_order_service/data/purchase_orders.db
ORDER_SERVICE_SEED_PATH=purchase_order_service/data/seed_purchase_orders.json
ORDER_SERVICE_ANALYTICS_SEED_PATH=purchase_order_service/data/seed_purchase_analytics.json
ORDER_SERVICE_API_KEY=
ORDER_SERVICE_ADMIN_API_KEY=
ORDER_SERVICE_OAUTH_JWKS_URL=
ORDER_SERVICE_OAUTH_ISSUER=
ORDER_SERVICE_OAUTH_AUDIENCE=
ORDER_SERVICE_OAUTH_ALGORITHMS=RS256
# Optional trusted-ingress header for mTLS termination; direct TLS peer cert is preferred.
# Configure the exact proxy CIDRs with the header. Other addresses cannot assert it.
ORDER_SERVICE_MTLS_VERIFIED_HEADER=
ORDER_SERVICE_TRUSTED_PROXY_CIDRS=
ORDER_SERVICE_SECRET_MASTER_KEY=
ORDER_SERVICE_SECRET_STORE_PATH=purchase_order_service/data/secrets.enc.json
ORDER_SERVICE_SECRET_PROVIDER=local
ORDER_SERVICE_VAULT_BASE_URL=
ORDER_SERVICE_VAULT_TOKEN=
ORDER_SERVICE_VAULT_TIMEOUT_SECONDS=5
