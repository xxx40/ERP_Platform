VITE_API_BASE_URL=http://127.0.0.1:8001

# Production OIDC Authorization Code + PKCE. Leave empty during local Vite development.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email offline_access
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=

# Local demonstration identity. Production identity must come from the API
# gateway/SSO and must not trust browser-supplied roles.
VITE_DEMO_USER_ID=demo-user
VITE_DEMO_TENANT_ID=tenant-demo
VITE_DEMO_ORG_CODE=ORG-DEMO-001
VITE_DEMO_ROLES=procurement_manager,platform_admin
